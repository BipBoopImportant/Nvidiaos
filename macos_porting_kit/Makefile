#
# Makefile for building the NVIDIA OS-agnostic 'nvKms' core into a
# static library on macOS.
#
# This Makefile is intended to be run from the macos_porting_kit directory.
# It serves as a diagnostic tool to identify all compilation errors that
# need to be addressed in the porting process.
#

# Compiler and Archiver
CC = clang
AR = ar

# Build Target
TARGET = libnvkms.a

# Compiler Flags
# -I. is added so our own dummy headers (like nv-firmware.h) are found first.
# The other -I flags point to the various include directories in the
# NVIDIA open-source repository.
CFLAGS = -c -g -Wall \
	-I. \
	-I../open-gpu-kernel-modules/src/nvidia/ \
	-I../open-gpu-kernel-modules/src/nvidia/inc/ \
	-I../open-gpu-kernel-modules/src/common/sdk/nvidia/inc/ \
	-I../open-gpu-kernel-modules/src/common/uproc/os/libos-v3.1.0/inc/ \
	-I../open-gpu-kernel-modules/src/nvidia/arch/nvalloc/unix/include/ \
	-I../open-gpu-kernel-modules/src/common/nvlink/in-band/inc/ \
	-I../open-gpu-kernel-modules/src/common/nvlink/kernel/nvlink/include/ \
	-I../open-gpu-kernel-modules/src/common/nvswitch/kernel/inc/ \
	-I../open-gpu-kernel-modules/src/nvidia/inc/libraries/

