# Object files are derived from source files
OBJS = $(SRCS:.c=.o)

# Default target
all: $(TARGET)

# Rule to link the static library
$(TARGET): $(OBJS)
	$(AR) rcs $(TARGET) $(OBJS)

# Rule to compile C source files
# This is a pattern rule. It matches any .c file and tells make how to
# create a corresponding .o file.
%.o: %.c
	$(CC) $(CFLAGS) -o $@ $<

# Clean up build artifacts
clean:
	rm -f $(TARGET) $(OBJS)

.PHONY: all clean